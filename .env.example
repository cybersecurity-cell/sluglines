# Public Supabase project values from Settings > API.
# Never use a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical application origin used for authentication callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
