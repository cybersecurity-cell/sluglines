# ============================================
# Sluglines Environment Variables
# Copy this file to .env.local and fill in
# your values from Supabase dashboard.
# ============================================

# Supabase — Get these from:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key (same dashboard page as above, "service_role" secret).
# Server-only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
# If unset: src/lib/supabase/service.ts throws on construction, which currently
# crashes the OTP send/verify routes with an unhandled 500 (they build this
# client to reach the durable rate limiter before calling Supabase Auth). It
# also means rate_limit_hit() is unreachable, so the durable, cross-instance
# OTP rate limiter silently has nothing to enforce.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key, for the AI concierge (src/lib/ai/agent.ts).
# If unset: createAnthropicClient() throws inside runAgentTurn's try block, so
# every agent turn ends in the generic "something went wrong" failure path —
# the assistant feature is unusable, but nothing else in the app is affected.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
